# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_HOSTS=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Clé séparée recommandée pour le site d'administration.
SUPABASE_ADMIN_SERVICE_ROLE_KEY=

# Secrets applicatifs — générer des valeurs aléatoires indépendantes.
PLAYER_KEY_SALT=
SPIN_TOKEN_SECRET=
CLAIM_TOKEN_SECRET=
TEAM_INVITE_TOKEN_SECRET=
UNSUBSCRIBE_TOKEN_SECRET=
LOYALTY_CHECKIN_TOKEN_SECRET=
JACKPOT_CHECKIN_TOKEN_SECRET=
SKILL_CHALLENGE_TOKEN_SECRET=
# Vide : la famille retombe SILENCIEUSEMENT sur SPIN_TOKEN_SECRET. Ce n'est pas
# une faille (chaque famille préfixe son message signé, un jeton de l'une n'est
# jamais vérifiable par l'autre), mais une rotation de SPIN_TOKEN_SECRET
# invalide alors TOUTES les familles restées sur le repli d'un seul coup.
# Quelles familles y sont : /api/health, détail `checks.token_secret_fallback`.
#
# Anciennes clés acceptées pendant une rotation, séparées par des virgules.
CLAIM_TOKEN_SECRET_PREVIOUS=
TEAM_INVITE_TOKEN_SECRET_PREVIOUS=
UNSUBSCRIBE_TOKEN_SECRET_PREVIOUS=
LOYALTY_CHECKIN_TOKEN_SECRET_PREVIOUS=
JACKPOT_CHECKIN_TOKEN_SECRET_PREVIOUS=
SKILL_CHALLENGE_TOKEN_SECRET_PREVIOUS=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Base d'API Stripe — TESTS UNIQUEMENT (stripe-mock ou stub local). Vide en
# production : le SDK vise alors api.stripe.com. La poser ailleurs qu'en test
# détournerait tous les appels de facturation.
STRIPE_API_BASE=
# Un price récurrent mensuel par offre (catalogue : src/lib/plans.ts).
# Une offre sans price reste affichée mais n'ouvre pas de checkout —
# le commerçant est invité à nous écrire au lieu de tomber sur une erreur.
# Coup d'envoi 29 €/mois — CORE puis STARTER sont d'anciens noms de l'offre ;
# les deux variables restent acceptées en repli, l'identifiant technique de
# l'offre reste `core` (il est stocké dans organizations.plan).
STRIPE_PRICE_ID_CORE=
STRIPE_PRICE_ID_STARTER=
# Le Club 59 €/mois (identifiant technique : engagement)
STRIPE_PRICE_ID_ENGAGEMENT=
# Sur Place 79 €/mois (identifiant technique : place). Carte au QR, agenda
# Réserver et les deux jeux de salon. Le nom commercial peut changer ; `place`
# est stocké dans organizations.plan et ne doit jamais bouger.
STRIPE_PRICE_ID_PLACE=
# Le Grand Jeu 89 €/mois (identifiant technique : live)
STRIPE_PRICE_ID_LIVE=
# La Totale 129 €/mois (identifiant technique : full)
STRIPE_PRICE_ID_FULL=
# Modules vendus à l'unité COMME LIGNES D'UN ABONNEMENT D'OFFRE (facultatif).
# Le webhook d'abonnement les traduit en booléens `addon_*` permanents.
STRIPE_PRICE_ID_ADDON_PRONOSTICS=
STRIPE_PRICE_ID_ADDON_HUNTS=
STRIPE_PRICE_ID_ADDON_LOYALTY=
STRIPE_PRICE_ID_ADDON_JACKPOT=
STRIPE_PRICE_ID_ADDON_EVENTS=
STRIPE_PRICE_ID_ADDON_CALENDAR=
STRIPE_PRICE_ID_ADDON_QUIZ=
STRIPE_PRICE_ID_ADDON_REFERRAL=
# Vitrine 20 €/mois et Réserver 30 €/mois. Elles n'existent QUE dans cette
# famille : elles s'ajoutent en ligne d'un abonnement en cours et n'ont donc
# aucun prix STRIPE_PRICE_ID_PASS_*. Duo Miroir et Portrait de la Bande ont été
# DÉTACHÉS de la Vitrine (migration 20261020120000) : ce sont désormais deux
# produits à eux, voir plus bas.
STRIPE_PRICE_ID_ADDON_VITRINE=
STRIPE_PRICE_ID_ADDON_RESERVER=
# Réservation (prise de rendez-vous) 20 €/mois — même famille de ligne.
STRIPE_PRICE_ID_ADDON_RENDEZ_VOUS=
# Duo Miroir et Portrait de la Bande, 12 €/mois chacun. Déclarés ici parce que
# la bijection catalogue ↔ Stripe l'exige (src/lib/plans.test.ts), mais la
# vente réelle passe par STRIPE_PRICE_ID_PASS_DUO / _BANDE ci-dessous : les
# deux salons sont dans les cinq offres, donc aucun abonné n'a de ligne à
# ajouter.
STRIPE_PRICE_ID_ADDON_DUO=
STRIPE_PRICE_ID_ADDON_BANDE=

# ── PASS AUTONOMES — l'AUTRE famille de prix, et il faut les deux ──
#
# ⚠️ NE PAS CONFONDRE AVEC LES `_ADDON_` CI-DESSUS. Ce sont deux PRODUITS
# distincts qui portent le même nom d'usage : une ligne d'abonnement d'un côté,
# un achat autonome et daté de l'autre. Réutiliser les mêmes prix ferait vendre
# l'un pour l'autre — un commerçant sans abonnement paierait une ligne qui ne
# s'attache à rien, ou un abonné recevrait un pass de trente jours à la place
# d'une option permanente. C'est cette famille-ci qui gouverne l'écran
# « Options » (/dashboard/settings/modules) et le canal add-on autonome.
# Grammaire des noms : src/lib/octroi-checkout.ts (`envAddon` / `envPalier`).
# Un pass sans prix n'est PAS proposé : l'écran dit « écrivez-nous ».
#
# Mensuels — créent chez Stripe un abonnement SÉPARÉ de celui de l'offre.
# Passeport des habitués, 19 €/mois sans engagement.
STRIPE_PRICE_ID_PASS_LOYALTY=
# Bouche-à-oreille / Parrainage, 12 €/mois sans engagement.
STRIPE_PRICE_ID_PASS_REFERRAL=
# Duo Miroir, 12 €/mois sans engagement.
# ⚠️ NE SE VEND QU'À UN COMMERÇANT SANS ABONNEMENT : les deux salons sont
# compris dans les CINQ offres, donc l'écran « Options » les marque
# « Comprise dans votre offre » à tout abonné et n'affiche aucun bouton.
STRIPE_PRICE_ID_PASS_DUO=
# Portrait de la Bande, 12 €/mois sans engagement. Même réserve que ci-dessus.
STRIPE_PRICE_ID_PASS_BANDE=
#
# Achats uniques — créer ces prix en « one-time » chez Stripe, jamais récurrents.
# Chasse au trésor, 29 € pour 30 jours d'usage, activable sous 90 jours.
STRIPE_PRICE_ID_PASS_HUNTS=
# Calendrier à surprises, 29 € pour une campagne de 31 jours maximum.
STRIPE_PRICE_ID_PASS_CALENDAR=
# Quiz express, 15 € pour 7 jours d'usage.
STRIPE_PRICE_ID_PASS_QUIZ=
# Cagnotte collective, 29 € pour 30 jours d'usage.
STRIPE_PRICE_ID_PASS_JACKPOT=
# Saison de pronostics, 39 € pour UNE compétition (l'achat exige un contest_id).
STRIPE_PRICE_ID_PASS_PRONOSTICS=
#
# Soirée en jeu — un prix PAR PALIER de jauge : chaque palier est un produit
# distinct, la jauge étant choisie avant paiement et jamais ajustée ensuite.
# 10 joueurs, 9 €.
STRIPE_PRICE_ID_PASS_EVENTS_10=
# 30 joueurs, 19 €.
STRIPE_PRICE_ID_PASS_EVENTS_30=
# 50 joueurs, 29 €.
STRIPE_PRICE_ID_PASS_EVENTS_50=
# Packs de crédits SMS — prix Stripe EN MODE PAIEMENT UNIQUE (pas récurrent).
# Un pack sans identifiant n'est simplement pas proposé au commerçant.
# ⚠️ Créer ces prix en « one-time » chez Stripe : un prix récurrent ferait
# naître un abonnement, donc des customer.subscription.* qui réécriraient le
# plan et les droits de l'organisation à partir d'un prix qui n'est pas une
# offre — acheter des SMS couperait l'accès aux modules payés.
STRIPE_PRICE_ID_SMS_100=
STRIPE_PRICE_ID_SMS_500=
STRIPE_PRICE_ID_SMS_2000=

# Canal SMS (Brevo)
# Sans ces deux clés, aucun SMS ne part et le « STOP » d'un client n'a nulle
# part où arriver — c'est-à-dire que le canal reste inerte, pas dégradé.
BREVO_API_KEY=
# Authentifie /api/sms/webhook (réception du STOP). CHEMIN PRÉFÉRÉ :
# l'en-tête `x-lastchance-sms-token` porte CE secret, posé à la création du
# webhook par l'API Brevo (POST /v3/webhooks, champ `headers`).
#
# Si le webhook est créé depuis la console web, qui n'expose que l'URL, la
# route accepte un JETON DÉRIVÉ en paramètre — jamais ce secret, qui n'a
# rien à faire dans une URL journalisée par l'hébergeur. Le calculer :
#
#   node -e "console.log(require('crypto').createHmac('sha256', process.env.BREVO_WEBHOOK_SECRET).update('brevo-url-token').digest('hex').slice(0,32))"
#
# puis coller https://<domaine>/api/sms/webhook?token=<jeton dérivé>.
BREVO_WEBHOOK_SECRET=
# Numéro court STOP déclaré chez Brevo. Vide : la mention légale du message
# reste générique, sans numéro à composer.
SMS_STOP_SHORTCODE=

# Emails
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Protection anti-bot (obligatoire par défaut en production)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Vide : facultatif en local, obligatoire implicitement en production.
TURNSTILE_REQUIRED=
TURNSTILE_ALLOWED_HOSTS=
TRUSTED_PROXY_PROVIDER=
# Collecteur de violations CSP (optionnel). Vide : aucune directive
# `report-uri`/`report-to` n'est émise — une campagne de mesure s'ouvre et se
# ferme avec cette seule variable. Doit être une URL https absolue.
CSP_REPORT_URI=

# Rate limiting distribué (optionnel)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Mode événement en direct (optionnel)
# Active le transport Realtime : un ping de rafraîchissement est diffusé à
# chaque transition, et les clients connectés espacent leur sondage à 30 s au
# lieu de 2,5 s. Le sondage reste le filet — vide, la soirée fonctionne, elle
# coûte simplement une requête toutes les 2,5 s par téléphone de la salle.
# Valeurs acceptées : 1 ou true. Toute autre valeur laisse le repli en place.
EVENTS_REALTIME_ENABLED=

# Analytics avec consentement (optionnel)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Sentry (optionnel)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SLOW_OPERATION_THRESHOLD_MS=1000

# Tâches planifiées et sessions admin
CRON_SECRET=
ADMIN_SESSION_MAX_MINUTES=480
ADMIN_SUDO_MINUTES=15

# Google Wallet (optionnel)
# Sert DEUX cartes : le pass d'un gain (code de retrait) et la carte du
# passeport de fidelite (solde de points + niveau). Tant que ce triplet est
# vide, les deux boutons « Ajouter a Google Wallet » n'existent tout simplement
# pas — aucun bouton grise, aucun message d'erreur, rien d'autre ne change.
#
# Ou les obtenir, dans cet ordre :
#  1. GOOGLE_WALLET_ISSUER_ID — creer un compte emetteur sur la Google Pay &
#     Wallet Console (https://pay.google.com/business/console), onglet « Google
#     Wallet API ». L'identifiant emetteur est un nombre a ~16 chiffres.
#  2. GOOGLE_WALLET_CLIENT_EMAIL / GOOGLE_WALLET_PRIVATE_KEY — creer un compte
#     de service dans la console Google Cloud du meme projet, lui generer une
#     cle JSON, puis AUTORISER ce compte de service dans la Wallet Console
#     (« Utilisateurs » → role Editeur) : sans cette autorisation, la signature
#     est valide mais Google refuse l'objet.
#     · CLIENT_EMAIL  = champ `client_email` du JSON (…@….iam.gserviceaccount.com)
#     · PRIVATE_KEY   = champ `private_key` du JSON, sur UNE seule ligne, avec
#       les sauts de ligne echappes en \n (le code les retablit au chargement).
#       C'est un SECRET : serveur uniquement, jamais un NEXT_PUBLIC_.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_CLIENT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=

# Apple Wallet (optionnel)
# Même principe que Google Wallet : tant que le quintette obligatoire est
# incomplet, le bouton « Ajouter à Apple Wallet » n'existe pas — rien d'autre
# ne change. Les trois PEM se collent sur UNE ligne, sauts de ligne échappés
# en \n (le code les rétablit au chargement) ; ce sont des SECRETS, jamais des
# NEXT_PUBLIC_.
#  · PASS_TYPE_ID  identifiant du Pass Type ID (ex. pass.fr.lastchance.gain)
#  · TEAM_ID       identifiant d'équipe du compte développeur Apple
#  · CERT_PEM      certificat du Pass Type ID
#  · KEY_PEM       clé privée de ce certificat
#  · WWDR_PEM      certificat intermédiaire Apple WWDR
#  · KEY_PASSPHRASE  facultatif — uniquement si la clé privée est chiffrée
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_CERT_PEM=
APPLE_WALLET_KEY_PEM=
APPLE_WALLET_WWDR_PEM=
APPLE_WALLET_KEY_PASSPHRASE=

# Calendriers sportifs — module Pronostics (optionnel)
# Vide = clé de test gratuite TheSportsDB (fenêtre ~15 événements).
# Une clé Premium élargit la fenêtre de synchronisation.
THESPORTSDB_API_KEY=

# Traduction automatique de la vitrine (optionnel)
# Clé Google Cloud Translation, SERVEUR uniquement (aucun préfixe NEXT_PUBLIC_ :
# une clé de traduction exposée au navigateur se facture à qui la ramasse).
# Vide : la traduction automatique est simplement indisponible, les textes
# saisis à la main restent servis tels quels.
GOOGLE_TRANSLATE_API_KEY=

# Mentions légales
LEGAL_ENTITY_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_POSTAL_ADDRESS=
LEGAL_HOST_NAME=
