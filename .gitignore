/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# supabase CLI local state
supabase/.temp/
supabase/.branches/

# typescript
*.tsbuildinfo
next-env.d.ts

# Sessions Playwright générées par e2e/auth.setup.ts
e2e/.auth/

# Artefacts E2E générés (caméra y4m)
e2e/.artifacts/

# Artefact de redirection PowerShell (nom de périphérique réservé Windows)
nul

# Worktrees git cree par Claude Code (contiennent des depots git)
.claude/worktrees/

# Fichiers de travail locaux (entrees de cadrage, notes)
Input/
.vscode/

# Skills installees par un plugin (Stripe et autres). Reinstallables a la
# demande et versionnees par leur fournisseur : les suivre ici ferait entrer
# dans le depot du code qu'on ne relit pas et qu'on ne corrige pas.
# `.claude/agents/`, `.claude/hooks/` et `.claude/commands/`, eux, RESTENT
# suivis : ils sont ecrits pour ce projet et leur perte serait une perte de
# travail.
.claude/skills/
skills-lock.json

# `.agents/` est la racine de personnalisation d'Antigravity. Elle a ete ignoree
# en bloc a l'epoque ou elle ne contenait que des copies de skills de plugin.
# Elle porte desormais de la configuration ecrite POUR ce projet — hooks, skills
# operationnelles, generateur de skills depuis `.claude/agents/` — dont la perte
# serait une perte de travail, exactement comme `.claude/agents/` et
# `.claude/hooks/`. On suit donc le contenu propre au projet, et on continue
# d'ignorer les copies de plugin et l'etat local des hooks.
.agents/*
!.agents/README.md
!.agents/hooks.json
!.agents/hooks/
!.agents/scripts/
!.agents/skills/
.agents/.etat/
.agents/skills/connect-recommend/
.agents/skills/stripe-best-practices/
.agents/skills/stripe-directory/
.agents/skills/stripe-docs/
.agents/skills/stripe-projects/
.agents/skills/upgrade-stripe/

# ── Outillage local de fond anime (« backdrop »), hors arbre route ──
#
# Ce lot etait ecrit sous `src/app/api/` et `site/src/app/api/`, donc compile
# par Next comme des routes de PRODUCTION : un balayage du reseau local par
# PowerShell (`/api/scan`), une ecriture de fichier dont le chemin venait du
# corps de la requete (`/api/save-frame`), cinq `execSync` dont la sortie
# repartait au client (`/api/test-tools`). Aucune n'etait authentifiee, et
# aucune n'etait dans ce fichier — un `git add .` les emportait.
#
# Elles vivent desormais dans `tools/backdrop/`, hors des deux arbres Next.
# La garde `src/lib/routes-sans-outillage.test.ts` empeche le retour du motif.
#
# On ignore aussi les SORTIES du generateur (74 Mo cote `public/`), jamais les
# assets de site legitimes : `site/public/images/` reste suivi si on l'ajoute.
tools/backdrop/
public/backdrop/
public/frames/
site/public/backdrop/
site/scripts/
scripts/build-backdrop-frames.mjs
scripts/gel-page-v2.mjs
scripts/gel-temoin-v2.mjs
scripts/scan-reseau.ps1
src/lib/backdrop-frames.ts
src/components/marketing/scroll-video-background.tsx
site/src/content/backdrop.ts
site/src/components/sections/scroll-backdrop.tsx
site/src/components/sections/game-homepage.tsx
