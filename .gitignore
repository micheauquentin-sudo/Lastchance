# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# supabase CLI local state
supabase/.temp/
supabase/.branches/

# typescript
*.tsbuildinfo
next-env.d.ts

# Sessions Playwright générées par e2e/auth.setup.ts
e2e/.auth/

# Artefacts E2E générés (caméra y4m)
e2e/.artifacts/

# Artefact de redirection PowerShell (nom de périphérique réservé Windows)
nul

# Worktrees git cree par Claude Code (contiennent des depots git)
.claude/worktrees/

# Fichiers de travail locaux (entrees de cadrage, notes)
Input/
.vscode/

# Skills installees par un plugin (Stripe et autres). Reinstallables a la
# demande et versionnees par leur fournisseur : les suivre ici ferait entrer
# dans le depot du code qu'on ne relit pas et qu'on ne corrige pas.
# `.claude/agents/` et `.claude/hooks/`, eux, RESTENT suivis : ils sont ecrits
# pour ce projet et leur perte serait une perte de travail.
.agents/
.claude/skills/
skills-lock.json
